{
  "name": "persona-agent",
  "version": "1.6.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.3.2",
  "scripts": {
    "dev": "cd packages/desktop && npm run dev",
    "build": "npm run build:server && npm run build:desktop && npm run dist",
    "build:server": "cd packages/server && bun run build",
    "build:desktop": "cd packages/desktop && npm run build",
    "dist": "cd packages/desktop && npm run dist",
    "dist:mac": "cd packages/desktop && npm run dist:mac",
    "dist:win": "cd packages/desktop && npm run dist:win",
    "typecheck": "cd packages/shared && bun run typecheck && cd ../server && bun run typecheck && cd ../desktop && npm run typecheck",
    "lint": "oxlint packages/shared/src packages/server/src packages/desktop/src",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\"",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "bump": "bun run scripts/bump-version.ts",
    "prepare": "husky && bun run scripts/postinstall-electron.ts"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.61.0",
    "prettier": "^3.8.3"
  },
  "trustedDependencies": [
    "electron",
    "esbuild",
    "protobufjs"
  ],
  "lint-staged": {
    "packages/*/src/**/*.{ts,tsx}": [
      "prettier --write",
      "oxlint"
    ]
  }
}
